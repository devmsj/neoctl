{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neo Desktop",
  "version": "0.1.7",
  "identifier": "com.neoctl.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Neo Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#f5f5f5",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../resources/payload/neoctl-web.tgz": "payload/neoctl-web.tgz",
      "../resources/payload/payload-manifest.json": "payload/payload-manifest.json",
      "../resources/node": "node"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
