{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-resources",
  "description": "Reveal local resources; command additionally checks the exact active runtime origin",
  "windows": ["main"],
  "local": false,
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": ["local-resources:allow-reveal-file", "local-resources:allow-watch-file-drops", "local-resources:allow-unwatch-file-drops", "local-resources:allow-take-file-drop"]
}
