{
  "name": "maker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm --prefix ../engine run build",
    "dev": "node scripts/dev.mjs --core local",
    "dev:package": "node scripts/dev.mjs --core package",
    "dev:ui": "vite",
    "test:xhs": "node --test artifacts.test.mjs",
    "test:runtime": "node --test runtime-router-cleanup.test.mjs",
    "test:plugins": "npm --prefix ../engine run build && node --test plugins.test.mjs plugin-settings.test.mjs",
    "test:monitoring": "node --test cpa-quota.test.mjs memory-monitor.test.mjs",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node server.mjs",
    "preview": "vite preview",
    "neo": "neo",
    "neo:web": "neo -web",
    "neo:login": "neo -login",
    "neo:help": "neo -help"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "neoctl": "0.2.30",
    "streaming-markdown": "^0.2.15",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^5.4.21"
  },
  "description": "一个 Render 风格的 Vue 3 + Vite 单页应用，面向设计人员和工作流用户封装 `neoctl` 本地 AI Agent 运行时。",
  "main": "vite.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
