# Active provider: openai, deepseek, or kimi
MODEL_PROVIDER=openai

# OpenAI provider settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.5
OPENAI_FALLBACK_MODEL=
OPENAI_ENDPOINT=auto

# DeepSeek provider settings
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODEL=

# Kimi provider settings
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_FALLBACK_MODEL=
# If your key was created on the international platform.kimi.ai, use:
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_* aliases are also accepted for Kimi API compatibility.
# MOONSHOT_API_KEY=your-kimi-api-key

# Shared model runtime settings
MODEL_REASONING_EFFORT=high
MODEL_REASONING_SUMMARY=auto
MODEL_MAX_OUTPUT_TOKENS=800
MODEL_TIMEOUT_MS=120000
MODEL_STREAM_IDLE_TIMEOUT_MS=120000
MODEL_MAX_RETRIES=2

# Web search provider. Leave SEARCH_PROVIDER empty to use OpenAI GPT search when
# MODEL_PROVIDER=openai / OPENAI_API_KEY is configured, otherwise Exa MCP.
SEARCH_PROVIDER=
SEARCH_TIMEOUT_MS=30000
OPENAI_SEARCH_MODEL=gpt-4.1-mini
OPENAI_SEARCH_CONTEXT_SIZE=medium
# OPENAI_SEARCH_API_KEY defaults to MODEL_API_KEY / OPENAI_API_KEY when omitted.
OPENAI_SEARCH_API_KEY=
# Set SEARCH_PROVIDER=exa to force Exa MCP.
EXA_MCP_URL=https://mcp.exa.ai/mcp
EXA_MCP_TOOL_NAME=web_search_exa

# Session transcripts are enabled by default under .agent/sessions.
# Set AGENT_SESSION_RESUME=1 to resume the newest session on startup, or set
# AGENT_SESSION_ID=<id> with AGENT_SESSION_RESUME=1 to resume a specific one.
AGENT_SESSION_TRANSCRIPT=1
AGENT_SESSION_RESUME=0
AGENT_SESSION_ID=
AGENT_SESSION_DIR=
