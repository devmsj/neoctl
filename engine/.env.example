MODEL_PROVIDER=openai
MODEL_API_KEY=your-api-key
MODEL_BASE_URL=https://api.openai.com
MODEL_ID=gpt-5.5
MODEL_REASONING_EFFORT=high
MODEL_ENDPOINT=auto
MODEL_MAX_OUTPUT_TOKENS=800
MODEL_TIMEOUT_MS=120000
MODEL_STREAM_IDLE_TIMEOUT_MS=120000
MODEL_MAX_RETRIES=2

# Session transcripts are enabled by default under .agent/sessions.
# Set AGENT_SESSION_RESUME=1 to resume the newest session on startup, or set
# AGENT_SESSION_ID=<id> with AGENT_SESSION_RESUME=1 to resume a specific one.
AGENT_SESSION_TRANSCRIPT=1
AGENT_SESSION_RESUME=0
AGENT_SESSION_ID=
AGENT_SESSION_DIR=

# OpenAI-compatible aliases are still supported for existing setups.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high
OPENAI_ENDPOINT=auto
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_MS=120000
OPENAI_STREAM_IDLE_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2
